# Copy to .env.local. Never use NEXT_PUBLIC_ for credentials.
SITE_URL=http://127.0.0.1:3000
TRUST_PROXY=false
PRIVACY_CONTACT_EMAIL=

# Gmail SMTP: enable 2-Step Verification and create an app password.
# This account is both the authenticated user and the sender.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# One recipient or comma-separated email addresses.
LEAD_EMAIL_TO=

# Apps Script production web app URL ending /exec, not the /dev test URL.
GOOGLE_SHEETS_WEBHOOK_URL=
# Random secret, at least 32 characters; same as Apps Script WEBHOOK_SECRET.
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Click-to-chat recipient: country code + number, digits only (91 + 10 digits).
# Visitors review the prefilled message and tap Send themselves.
WHATSAPP_RECIPIENT=
